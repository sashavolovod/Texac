  <Code>Public Function IsWeekend(year As Integer, month As Integer, day As Integer) As Boolean
    Dim dt As DateTime = New DateTime(year, month, day)
    Return dt.DayOfWeek = DayOfWeek.Saturday OrElse dt.DayOfWeek = DayOfWeek.Sunday
End Function</Code>
